{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitch.dev/schema/hitch.release-plan.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateDigest",
    "payloadDigest",
    "destination",
    "ownedPaths",
    "copies",
    "deletions",
    "actions",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "candidateDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "expectedBase",
        "branch",
        "layout",
        "path",
        "baseBranch",
        "remote",
        "immutable"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "expectedBase": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "enum": [
            "root",
            "subdirectory"
          ]
        },
        "path": {
          "type": "string"
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "immutable": {
          "type": "boolean"
        }
      }
    },
    "ownedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "copies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "deletions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "actions": {
      "const": [
        "create-review-branch",
        "copy-approved-files",
        "remove-owned-stale-files",
        "commit",
        "verify-local"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
