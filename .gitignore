# beads issue-tracker local state, if this repo ever gets onboarded as a rig.
.beads/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# bv (beads viewer) local config and caches
.bv/

# beads: zero-footprint hive (furnish: none) — .beads/ is local-only state.
# bd takes its gate lock at the REPO ROOT, so a .beads/ rule alone misses it.
.beads.gate.lock

# retro pipeline scripts import each other (_rundir, extract) — bytecode caches are local.
__pycache__/
*.pyc
