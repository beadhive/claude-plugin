# Beads working copy / exports — no issue data on GitHub
.beads/*.jsonl

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# bv (beads viewer) local config and caches
.bv/

# bd takes its gate lock at the REPO ROOT, so a .beads/ rule alone misses it.
.beads.gate.lock

# retro pipeline scripts import each other (_rundir, extract) — bytecode caches are local.
__pycache__/
*.pyc
